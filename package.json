{
  "name": "celeris",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx saas/api/index.ts",
    "start": "node --import tsx saas/api/index.ts",
    "start:api": "node --import tsx saas/api/index.ts",
    "test": "node --import tsx --test saas/tests/*.test.ts",
    "test:watch": "node --watch --import tsx --test saas/tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "psql \"$DATABASE_URL\" -f saas/db/migrations/001_foundations.sql"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
